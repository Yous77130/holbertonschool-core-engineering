# Copy this file to .env and adjust values for your local setup.
# .env is gitignored and must never be committed.

# Base URL of the local Ollama server.
OLLAMA_API_BASE=http://localhost:11434

# Model used by every agent, in LiteLLM's ollama_chat/<model> format.
# Must match a model already pulled with `ollama pull <model>`.
MODEL_NAME=ollama_chat/llama3
